# ============ yamb-plus 配置 ============
# 复制为 .env 后填写（.env 已被 .gitignore 忽略，密钥只放这里）。

# ── 控制器（QQ 指令 -> MC 机器人，controller/controller.js）──
CTRL_PORT=15100
# 必填：控制器 API key，随便一串随机字符（install.sh 会自动生成，也可自己填）
CTRL_KEY=
# AstrBot 插件 astrbot_plugin_mcbot 通过容器环境变量读取 CTRL_PORT / CTRL_KEY
# 与 FLEET_FILE（见 deploy/docker-compose.example.yml）

# ── yamb（MC 挂机本体，克隆到 <仓库>/yamb）──
# 必填：yamb HTTP API key（yamb 自己的 .env 里同名键，两边保持一致）
YAMB_API_KEY=
# yamb 热上下号控制口（pkg65 加的功能）
YAMB_CONTROL_PORT=15199

# ── NapCat（QQ 协议端）──
# 必填：NapCat HTTP API token（每个容器 config 里配的那个）
NAPCAT_TOKEN=
NAPCAT_HOST=127.0.0.1
NAPCAT_PRIMARY_PORT=3000
NAPCAT_SPARE_PORT=3001
# compose 工作目录（docker-compose.yml 所在处）
NAPCAT_COMPOSE_DIR=deploy/compose

# ── NapCat 容器的 QQ 账号（被 docker-compose.example.yml 引用）──
NAPCAT_UID=1000
NAPCAT_GID=1000
NAPCAT_A_ACCOUNT=
NAPCAT_B_ACCOUNT=

# AstrBot 数据目录（宿主机绝对路径）与舰队配置挂载目录
ASTRBOT_DATA_DIR=
FLEET_FILE_HOST_DIR=

# ── 舰队配置（QQ号 / MC账号 / bot名 / 管理员，全部在这份 gitignore 的 JSON 里）──
FLEET_FILE=config/fleet.json

# ── 数据 / 日志 ──
STATE_FILE=data/state.json
MC_LOG_FILE=data/last-run.log
MONITOR_LOG=data/monitor.log
# 体检脚本里 systemctl list-timers 检查的定时器名单
MCBOT_TIMERS=qqbot-monitor.timer qqbot-heartbeat.timer

# ── keepalive（switch.sh ensure）宽限期/冷却秒数 ──
MCBOT_KEEPALIVE_GRACE=120
MCBOT_KEEPALIVE_COOLDOWN=900
